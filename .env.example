# ---------------------------------------------------------------------------
# LN Digitech — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real credentials. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Canonical production origin used for canonical URLs, sitemap, robots,
# Open Graph URLs and JSON-LD. No trailing slash.
# Example: https://www.lndigitech.com
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery (Web3Forms).
# 1. Create a free account at https://web3forms.com
# 2. Copy your Access Key from the dashboard
# 3. Set the recipient inbox in the Web3Forms dashboard (Settings -> Email)
# 4. Paste the access key below.
# The access key is designed for browser use and is not a secret server
# credential, but it must still never be hardcoded into source control.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY= your-access-key-here
