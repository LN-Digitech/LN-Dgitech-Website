# ---------------------------------------------------------------------------
# LN Digitech — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real credentials. `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# Canonical production origin used for canonical URLs, sitemap, robots,
# Open Graph URLs and JSON-LD. No trailing slash.
# Example: https://www.lndigitech.com
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form email delivery (Resend).
# 1. Create an account at https://resend.com
# 2. Verify your sending domain (or use the test domain for development)
# 3. Create an API key and paste it below.
RESEND_API_KEY=

# Where contact-form notifications are delivered.
CONTACT_NOTIFICATION_EMAIL=hello@example.com

# Optional: address the notifications are sent FROM. Must be an address on
# your verified Resend domain. Defaults to onboarding@resend.dev in dev.
CONTACT_FROM_EMAIL=

# Optional: comma-separated list of extra emails to CC on inquiries.
CONTACT_CC_EMAILS=

# Development-only override: when "true", the contact API validates input and
# reports success WITHOUT attempting to send email. Useful before Resend is
# configured. Production always attempts real delivery when RESEND_API_KEY is set.
# Leave unset (or "false") in production.
CONTACT_DEV_STUB=
